{
  "compilerOptions": {
    "lib": ["ES2020", "ES2021", "ES2022", "ESNext"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "target": "es2020",
    "sourceMap": true,
    "incremental": true,
    "paths": {}
  },
  "include": ["tests/**/*", "vitest.config.mjs", ".hygen.ts", "_templates/**/*.ts"],
  "exclude": ["node_modules", "tmp", "allure-results"]
}
